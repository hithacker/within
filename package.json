{
  "name": "within-reflection",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:api": "npm --prefix server run dev",
    "start:studio": "npm --prefix studio run dev",
    "dev": "concurrently -n app,api -c cyan,yellow \"npm:start\" \"npm:start:api\"",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test:api": "npm --prefix server test",
    "typecheck:studio": "npm --prefix studio run typecheck"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2"
  }
}
